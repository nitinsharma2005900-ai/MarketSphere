{$MARKETSPHERE_DOMAIN} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api:4040
  }
  handle /api-docs* {
    reverse_proxy api:4040
  }
  handle /health {
    reverse_proxy api:4040
  }
  handle {
    reverse_proxy frontend:3040
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
