# Use .env.example as the complete template; override these for staging.
NODE_ENV=production
DEMO_MODE=false
MARKETSPHERE_DOMAIN=staging.example.invalid
FRONTEND_URL=https://staging.example.invalid
NEXT_PUBLIC_API_URL=https://staging.example.invalid/api/v1
NEXT_PUBLIC_DEMO_MODE=false
DATABASE_URL=postgresql://APP_USER:SECRET@PRIVATE_DATABASE:5432/marketsphere_staging
REDIS_URL=redis://PRIVATE_REDIS:6379
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SANDBOX_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_SANDBOX_SECRET
