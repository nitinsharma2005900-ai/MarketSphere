generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  SELLER
  WAREHOUSE
  SUPPORT
  ADMIN
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(CUSTOMER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  seller Seller?
  tokens RefreshToken[]
  addresses Address[]
  cart Cart?
  orders Order[]
  reviews Review[]
  events BrowseEvent[]
  tickets Ticket[] @relation("Requester")
  assignments Ticket[] @relation("Assignee")
  audits AuditLog[]
  redemptions PromotionUse[]
}
model RefreshToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  tokenHash String @unique
  family String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([family])
}
model Seller {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id])
  name String
  status String @default("PENDING")
  commissionBps Int @default(1000)
  createdAt DateTime @default(now())
  products Product[]
  items OrderItem[]
  settlements Settlement[]
  financialMovements FinancialMovement[]
}
model Category {
  id String @id @default(uuid())
  name String @unique
  slug String @unique
  products Product[]
}
model Product {
  id String @id @default(uuid())
  sellerId String
  seller Seller @relation(fields:[sellerId],references:[id])
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  name String
  slug String @unique
  description String
  image String
  status String @default("PENDING")
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants Variant[]
  reviews Review[]
  events BrowseEvent[]
  @@index([status,categoryId,createdAt])
  @@index([sellerId])
}
model Variant {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields:[productId],references:[id])
  sku String @unique
  name String
  price Int
  attributes Json @default("{}")
  inventory Inventory[]
  cartItems CartItem[]
  orderItems OrderItem[]
}
model Warehouse {
  id String @id @default(uuid())
  name String @unique
  city String
  inventory Inventory[]
  shipments Shipment[]
}
model Inventory {
  id String @id @default(uuid())
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  onHand Int @default(0)
  reserved Int @default(0)
  threshold Int @default(5)
  movements StockMovement[]
  reservations Reservation[]
  @@unique([variantId,warehouseId])
}
model StockMovement {
  id String @id @default(uuid())
  inventoryId String
  inventory Inventory @relation(fields:[inventoryId],references:[id])
  key String @unique
  kind String
  deltaOnHand Int
  deltaReserved Int
  reason String
  createdAt DateTime @default(now())
  @@index([inventoryId,createdAt])
}
model Cart {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id])
  updatedAt DateTime @updatedAt
  items CartItem[]
}
model CartItem {
  id String @id @default(uuid())
  cartId String
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  quantity Int
  @@unique([cartId,variantId])
}
model Address {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  name String
  line1 String
  city String
  region String
  postalCode String
  country String @default("IN")
}
model Order {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  checkoutKey String
  status String @default("PENDING_PAYMENT")
  subtotal Int
  discount Int @default(0)
  shipping Int @default(0)
  total Int
  currency String @default("INR")
  address Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  reservations Reservation[]
  payment Payment?
  shipments Shipment[]
  returns ReturnRequest[]
  tickets Ticket[]
  promotionUse PromotionUse?
  @@unique([userId,checkoutKey])
  @@index([status,expiresAt])
  @@index([userId,createdAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  sellerId String
  seller Seller @relation(fields:[sellerId],references:[id])
  name String
  quantity Int
  fulfilled Int @default(0)
  unitPrice Int
  discount Int @default(0)
  commission Int
  shipmentItems ShipmentItem[]
  returnItems ReturnItem[]
  settlementItem SettlementItem?
  financialMovements FinancialMovement[]
  @@index([sellerId])
}
model Reservation {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  inventoryId String
  inventory Inventory @relation(fields:[inventoryId],references:[id])
  quantity Int
  status String @default("ACTIVE")
  expiresAt DateTime
  @@unique([orderId,inventoryId])
  @@index([status,expiresAt])
}
model Promotion {
  id String @id @default(uuid())
  code String @unique
  discountBps Int
  minSubtotal Int @default(0)
  maxDiscount Int
  active Boolean @default(true)
  endsAt DateTime
  uses PromotionUse[]
}
model PromotionUse {
  id String @id @default(uuid())
  promotionId String
  promotion Promotion @relation(fields:[promotionId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  @@unique([promotionId,userId])
}
model Payment {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields:[orderId],references:[id])
  provider String
  providerRef String @unique
  status String @default("PENDING")
  amount Int
  events PaymentEvent[]
  refunds Refund[]
}
model PaymentEvent {
  id String @id
  paymentId String
  payment Payment @relation(fields:[paymentId],references:[id])
  type String
  createdAt DateTime @default(now())
}
model Shipment {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  warehouseId String
  warehouse Warehouse @relation(fields:[warehouseId],references:[id])
  key String @unique
  providerRef String @unique
  status String @default("PREPARED")
  createdAt DateTime @default(now())
  items ShipmentItem[]
  events ShippingEvent[]
}
model ShipmentItem {
  id String @id @default(uuid())
  shipmentId String
  shipment Shipment @relation(fields:[shipmentId],references:[id])
  orderItemId String
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  quantity Int
  @@unique([shipmentId,orderItemId])
}
model ShippingEvent {
  id String @id
  shipmentId String
  shipment Shipment @relation(fields:[shipmentId],references:[id])
  status String
  createdAt DateTime @default(now())
}
model ReturnRequest {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  reason String
  status String @default("REQUESTED")
  createdAt DateTime @default(now())
  items ReturnItem[]
  refund Refund?
  dispute Dispute?
}
model ReturnItem {
  id String @id @default(uuid())
  returnId String
  returnRequest ReturnRequest @relation(fields:[returnId],references:[id])
  orderItemId String
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  quantity Int
  @@unique([returnId,orderItemId])
}
model Refund {
  id String @id @default(uuid())
  returnId String @unique
  returnRequest ReturnRequest @relation(fields:[returnId],references:[id])
  paymentId String
  payment Payment @relation(fields:[paymentId],references:[id])
  providerRef String @unique
  amount Int
  status String @default("PENDING")
  createdAt DateTime @default(now())
  events RefundEvent[]
  financialMovements FinancialMovement[]
}
model FinancialMovement {
  id String @id @default(uuid())
  sellerId String
  seller Seller @relation(fields:[sellerId],references:[id])
  orderItemId String
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  refundId String
  refund Refund @relation(fields:[refundId],references:[id])
  amount Int
  commission Int
  kind String @default("REFUND_REVERSAL")
  createdAt DateTime @default(now())
  @@unique([refundId,orderItemId])
  @@index([sellerId,createdAt])
}
model RefundEvent {
  id String @id
  refundId String
  refund Refund @relation(fields:[refundId],references:[id])
  createdAt DateTime @default(now())
}
model Review {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  productId String
  product Product @relation(fields:[productId],references:[id])
  rating Int
  comment String
  createdAt DateTime @default(now())
  @@unique([userId,productId])
}
model Settlement {
  id String @id @default(uuid())
  sellerId String
  seller Seller @relation(fields:[sellerId],references:[id])
  key String @unique
  amount Int
  status String @default("RECORDED")
  createdAt DateTime @default(now())
  items SettlementItem[]
}
model SettlementItem {
  id String @id @default(uuid())
  settlementId String
  settlement Settlement @relation(fields:[settlementId],references:[id])
  orderItemId String @unique
  orderItem OrderItem @relation(fields:[orderItemId],references:[id])
  amount Int
}
model Ticket {
  id String @id @default(uuid())
  userId String
  user User @relation("Requester",fields:[userId],references:[id])
  assigneeId String?
  assignee User? @relation("Assignee",fields:[assigneeId],references:[id])
  orderId String?
  order Order? @relation(fields:[orderId],references:[id])
  subject String
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  messages TicketMessage[]
  dispute Dispute?
}
model TicketMessage {
  id String @id @default(uuid())
  ticketId String
  ticket Ticket @relation(fields:[ticketId],references:[id])
  authorId String
  text String
  createdAt DateTime @default(now())
}
model Dispute {
  id String @id @default(uuid())
  ticketId String @unique
  ticket Ticket @relation(fields:[ticketId],references:[id])
  returnId String? @unique
  returnRequest ReturnRequest? @relation(fields:[returnId],references:[id])
  status String @default("OPEN")
  resolution String?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(uuid())
  userId String?
  user User? @relation(fields:[userId],references:[id])
  action String
  resourceId String
  details Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model BrowseEvent {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id])
  productId String
  product Product @relation(fields:[productId],references:[id])
  type String
  createdAt DateTime @default(now())
  @@index([userId,createdAt])
}
model Outbox {
  id String @id @default(uuid())
  key String @unique
  type String
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@index([processedAt,createdAt])
}
