      "name": "List categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Search approved products with pagination and category, seller, price and sort filters",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
