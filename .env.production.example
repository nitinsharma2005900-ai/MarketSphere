# Educational production-like deployment; only synthetic data and sandbox payments are supported.
# Start with the complete .env.example; use independent secrets and data stores for each environment.
NODE_ENV=production
DEMO_MODE=false
MARKETSPHERE_DOMAIN=marketplace.example.invalid
FRONTEND_URL=https://marketplace.example.invalid
NEXT_PUBLIC_API_URL=https://marketplace.example.invalid/api/v1
NEXT_PUBLIC_DEMO_MODE=false
DATABASE_URL=postgresql://APP_USER:SECRET@PRIVATE_DATABASE:5432/marketsphere_production
REDIS_URL=redis://PRIVATE_REDIS:6379
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SANDBOX_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_SANDBOX_SECRET
